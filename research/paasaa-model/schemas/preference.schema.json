{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "preferred_candidate": {
      "type": [
        "string",
        "null"
      ]
    },
    "rejected_candidate": {
      "type": [
        "string",
        "null"
      ]
    },
    "preferred_response": {
      "type": [
        "string",
        "null"
      ]
    },
    "rejected_response": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "unselected_pending_review",
        "reviewed"
      ]
    }
  },
  "required": [
    "scenario_id",
    "preferred_candidate",
    "rejected_candidate",
    "preferred_response",
    "rejected_response",
    "reason",
    "status"
  ],
  "additionalProperties": false
}
