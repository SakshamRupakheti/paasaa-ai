GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

PAASAA_AI_PROVIDER=groq
PAASAA_CONVERSATION_MODEL=openai/gpt-oss-120b
PAASAA_PLANNER_MODEL=openai/gpt-oss-20b
PAASAA_SAFETY_MODEL=openai/gpt-oss-safeguard-20b

# Optional shared reply-model override (planner/safety remain separately configured).
GROQ_MODEL=

# Vercel account storage. Only the publishable key is returned to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Restricts the synthetic internal workspace to a verified owner account.
PAASAA_PROTOTYPE_OWNER_EMAIL=

# Operator kill switch for all Groq generation and transcription. Defaults on.
PAASAA_AI_ENABLED=true
